---
import BrandNav from '../components/BrandNav.astro';
import FeedToShelf from '../components/FeedToShelf.astro';
import HeroCollage from '../components/HeroCollage.astro';
import MagneticButton from '../components/MagneticButton.astro';
import WaitlistSignup from '../components/WaitlistSignup.astro';
import WorkflowArtifacts from '../components/WorkflowArtifacts.astro';
import { finalCta, hero } from '../data/landing-content';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mentioned - Turn BookTok into your reading list"
  description="Mentioned turns BookTok and Reels into reading lists, saving each book with the post that made you want to read it."
>
  <div class="page-shell">
    <BrandNav />

    <main>
      <section class="section-band hero-section">
        <div class="section-inner hero-section__inner">
          <div class="hero-section__copy" data-reveal>
            <span class="eyebrow">Mentioned for readers</span>
            <h1>{hero.title}</h1>
            <p>{hero.body}</p>
            <div class="hero-section__actions">
              <MagneticButton href={hero.primaryCta.href} label={hero.primaryCta.label} />
              <MagneticButton href={hero.secondaryCta.href} label={hero.secondaryCta.label} variant="quiet" />
            </div>
          </div>
          <HeroCollage />
        </div>
      </section>

      <WorkflowArtifacts />
      <FeedToShelf />
      <WaitlistSignup />

      <section id="final-cta" class="section-band final-cta-section">
        <div class="section-inner final-cta-section__inner double-bezel" data-reveal>
          <div class="double-bezel__core final-cta-section__core">
            <div>
              <span class="eyebrow">Keep the reason</span>
              <h2>{finalCta.title}</h2>
              <p>{finalCta.body}</p>
            </div>
            <div class="final-cta-section__actions">
              <MagneticButton href={finalCta.primaryCta.href} label={finalCta.primaryCta.label} />
              <MagneticButton href={finalCta.secondaryCta.href} label={finalCta.secondaryCta.label} variant="quiet" />
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Mentioned</span>
      <a href="/privacy">Privacy</a>
      <a href="/support">Support</a>
    </footer>
  </div>
</BaseLayout>
