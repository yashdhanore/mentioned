---
import { hero, navItems } from '../data/landing-content';
import MagneticButton from './MagneticButton.astro';
---

<header class="site-nav">
  <a class="site-nav__brand" href="/" aria-label="Mentioned home">
    <span class="site-nav__mark">
      <img src="/assets/app-mark.png" alt="" width="32" height="32" />
    </span>
    <span>Mentioned</span>
  </a>

  <nav class="site-nav__links" aria-label="Primary navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="site-nav__action">
    <MagneticButton href={hero.primaryCta.href} label={hero.primaryCta.label} />
  </div>
</header>
