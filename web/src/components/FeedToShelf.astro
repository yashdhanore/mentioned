---
import { shelfBooks } from '../data/landing-content';
---

<section id="shelf" class="section-band shelf-section">
  <div class="section-inner shelf-section__inner">
    <div class="shelf-section__copy" data-reveal>
      <span class="eyebrow">Saved with the Reel</span>
      <h2>The post stays with the books.</h2>
      <p>Mentioned pulls the book rec out of the Reel, then keeps the post attached so you remember why it mattered.</p>
    </div>

    <div class="shelf-stage" data-shelf-stage>
      <div class="shelf-stage__fragments" aria-hidden="true">
        <article class="feed-fragment feed-fragment--one" data-shelf-fragment>book rec in a Reel</article>
        <article class="feed-fragment feed-fragment--two" data-shelf-fragment>caption names the books</article>
        <article class="feed-fragment feed-fragment--three" data-shelf-fragment>comments ask for the list</article>
      </div>

      <div class="phone-shell double-bezel" data-shelf-phone>
        <div class="double-bezel__core phone-shell__core">
          <div class="phone-shell__status">9:41</div>
          <h3>My Shelf</h3>
          <div class="phone-shell__tabs">
            <span>All</span>
            <span>To Read</span>
            <span>Reading</span>
          </div>
          <div class="phone-shell__books">
            {shelfBooks.map((book) => (
              <article>
                <span class:list={['book-spine', `book-spine--${book.tone}`]}>{book.title.slice(0, 2)}</span>
                <div>
                  <strong>{book.title}</strong>
                  <small>{book.author}</small>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <article class="source-memory double-bezel" data-shelf-memory>
        <div class="double-bezel__core source-memory__core">
          <span>Attached Reel</span>
          <p>"A short list of books I keep coming back to."</p>
          <small>Saved with 3 books</small>
        </div>
      </article>
    </div>
  </div>
</section>
