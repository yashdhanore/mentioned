APP_ENV=local
DATABASE_URL=sqlite:///app.db
AUTO_CREATE_TABLES=true
AUTH_MODE=dev
DEV_USER_ID=00000000-0000-4000-8000-000000000001
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=
SOURCE_REQUIRE_HTTPS=false
MAX_JOB_CREATE_BURST_PER_MINUTE=3
MAX_JOBS_CREATED_PER_DAY=25
MAX_ACTIVE_JOBS_PER_USER=5
WORKER_ID=worker-local
WORKER_STALE_TIMEOUT_SECONDS=900
WORKER_RETRY_BASE_DELAY_SECONDS=30

OPENAI_API_KEY=
MULTIMODAL_LLM_PROVIDER=none
OPENAI_MULTIMODAL_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
OPENAI_STORE_RESPONSES=false

ASR_PROVIDER=none
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
OPENAI_ASR_PROMPT=
MAX_ASR_AUDIO_BYTES=26214400
OCR_PROVIDER=tesseract

MAX_SELECTED_FRAMES=8
MAX_SELECTED_POST_IMAGES=10
MAX_LLM_IMAGES=20
MAX_LLM_CROPS=12
MAX_LLM_CALLS_PER_JOB=1
MAX_IMAGE_LONG_EDGE_PX=1280
LLM_TIMEOUT_SECONDS=60
